    "bridge": "Optional Codex bridge actually available and authorized",
    "figma-execute": "Selected tool response envelope is figma_execute",
    "nested": "Source subtree contains instances",
    "delegation": "An instance is reused through a mapped DS component",
    "modes": "Multiple/forced collection modes or mode-dependent aliases",
    "float": "Observed FLOAT serialization is needed/undecided",
    "first": "First import or incomplete initial scaffold",
    "next": "Existing scaffold, next component",
    "text": "Captured TEXT nodes, including hidden text",
